# ─────────────────────────────────────────────────────────────────────────────
# EduWings — environment configuration
#
# Copy to `.env.local` and fill in. EVERY variable here is optional: the app is
# designed to boot, build and render the full public site with none of them set.
# Each block below unlocks an additional capability.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical public origin. Used for SEO metadata, sitemap, OpenGraph and email links.
# Vercel sets NEXT_PUBLIC_SITE_URL automatically in production if you add it there.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Supabase ────────────────────────────────────────────────────────────────
# Set these three to switch the content layer from bundled seed content to the
# live database, and to enable Supabase Auth + the admin CMS at /admin.
# Project settings → API. See supabase/migrations for the schema.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Never expose this to the browser — it bypasses Row Level Security.
# Required for admin writes, media uploads and user management.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Transactional email (Resend) ────────────────────────────────────────────
# Without these, form submissions are still persisted/validated but no email is
# dispatched — the app logs a structured warning instead of failing the request.
RESEND_API_KEY=""
EMAIL_FROM="EduWings <noreply@eduwings.org>"
EMAIL_TO_ADMIN="hello@eduwings.org"

# ── Analytics (optional) ────────────────────────────────────────────────────
# Any privacy-friendly script host. Leave blank to render no analytics at all.
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
NEXT_PUBLIC_ANALYTICS_SRC=""
